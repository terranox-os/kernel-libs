load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

# ── C implementation ─────────────────────────────────────────

cc_library(
    name = "gen_sync",
    srcs = [
        "src/spinlock.c",
        "src/once.c",
        "src/atomic_bitops.c",
    ],
    hdrs = ["include/gen_sync.h"],
    includes = ["include"],
    copts = [
        "-ffreestanding",
        "-nostdlib",
        "-std=c17",
        "-Wall",
        "-Wextra",
        "-Werror",
        "-Wpedantic",
    ],
)

cc_test(
    name = "sync_test",
    srcs = ["tests/sync_test.c"],
    deps = [":gen_sync"],
    copts = [
        "-std=c17",
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
)

# ── Rust implementation ──────────────────────────────────────

rust_library(
    name = "kernel_sync",
    srcs = [
        "src/lib.rs",
        "src/spinlock.rs",
        "src/once.rs",
        "src/atomic_bitops.rs",
    ],
    crate_name = "kernel_sync",
    edition = "2021",
    deps = ["//genesis-abi:genesis_abi_rs"],
)

rust_test(
    name = "kernel_sync_test",
    crate = ":kernel_sync",
)

exports_files(["Cargo.toml"])
