load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

# ── C implementation ─────────────────────────────────────────

cc_library(
    name = "gen_kfmt",
    srcs = ["src/kprintf.c"],
    hdrs = ["include/gen_kfmt.h"],
    includes = ["include"],
    copts = [
        "-ffreestanding",
        "-nostdlib",
        "-std=c17",
        "-Wall",
        "-Wextra",
        "-Werror",
        "-Wpedantic",
    ],
    deps = ["//genesis-abi:genesis_abi"],
)

cc_test(
    name = "kprintf_test",
    srcs = ["tests/kprintf_test.c"],
    deps = [":gen_kfmt"],
    copts = [
        "-std=c17",
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
)

# ── Rust implementation ──────────────────────────────────────

rust_library(
    name = "kernel_kfmt",
    srcs = ["src/lib.rs"],
    crate_name = "kernel_kfmt",
    edition = "2021",
    deps = ["//genesis-abi:genesis_abi_rs"],
)

rust_test(
    name = "kernel_kfmt_test",
    crate = ":kernel_kfmt",
)

exports_files(["Cargo.toml"])
