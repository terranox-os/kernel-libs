load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

# ── C header-only library (arch-gated inline asm) ──────────

cc_library(
    name = "gen_arch_intrinsics",
    hdrs = [
        "include/gen_arch_x86_64.h",
        "include/gen_arch_aarch64.h",
        "include/gen_arch_arm_cm.h",
        "include/gen_arch_riscv64.h",
    ],
    includes = ["include"],
    copts = [
        "-ffreestanding",
        "-nostdlib",
        "-std=c17",
        "-Wall",
        "-Wextra",
        "-Werror",
        "-Wpedantic",
    ],
)

# ── Rust implementation ──────────────────────────────────────

rust_library(
    name = "kernel_arch_intrinsics",
    srcs = [
        "src/lib.rs",
        "src/x86_64.rs",
        "src/aarch64.rs",
        "src/arm_cm.rs",
        "src/riscv64.rs",
    ],
    crate_name = "kernel_arch_intrinsics",
    edition = "2021",
    deps = ["//genesis-abi:genesis_abi_rs"],
)

# No rust_test: inline asm functions cannot be tested on host
# without the actual hardware. Cross-compile to verify:
#   bazel build //arch-intrinsics:kernel_arch_intrinsics \
#     --platforms=@rules_rust//rust/platform:aarch64-unknown-none

exports_files(["Cargo.toml"])
