load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "genesis_abi",
    hdrs = [
        "include/genesis_module.h",
        "include/genesis_result.h",
        "include/genesis_syscall.h",
    ],
    includes = ["include"],
    copts = [
        "-ffreestanding",
        "-nostdlib",
        "-std=c17",
        "-Wall",
        "-Wextra",
        "-Werror",
        "-Wpedantic",
    ],
)

cc_test(
    name = "genesis_abi_compile_test",
    srcs = ["tests/compile_test.c"],
    deps = [":genesis_abi"],
    copts = [
        "-std=c17",
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
)
