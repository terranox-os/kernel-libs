load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "kernel_crypto",
    srcs = [
        "src/lib.rs",
        "src/crc32.rs",
        "src/sha256.rs",
        "src/hmac.rs",
    ],
    crate_name = "kernel_crypto",
    edition = "2021",
    crate_features = ["crc32-table"],
    deps = ["//genesis-abi:genesis_abi_rs"],
)

rust_test(
    name = "kernel_crypto_test",
    crate = ":kernel_crypto",
)

exports_files(["Cargo.toml"])
