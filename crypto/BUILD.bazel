load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

# ── C implementation ─────────────────────────────────────────

cc_library(
    name = "gen_crypto",
    srcs = [
        "src/crc32.c",
        "src/sha256.c",
        "src/hmac.c",
    ],
    hdrs = ["include/gen_crypto.h"],
    includes = ["include"],
    copts = [
        "-ffreestanding",
        "-nostdlib",
        "-std=c17",
        "-Wall",
        "-Wextra",
        "-Werror",
        "-Wpedantic",
    ],
)

cc_test(
    name = "crypto_test",
    srcs = ["tests/crypto_test.c"],
    deps = [":gen_crypto"],
    copts = [
        "-std=c17",
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
)

# ── Rust implementation ──────────────────────────────────────

rust_library(
    name = "kernel_crypto",
    srcs = [
        "src/lib.rs",
        "src/crc32.rs",
        "src/sha256.rs",
        "src/hmac.rs",
    ],
    crate_name = "kernel_crypto",
    edition = "2021",
    crate_features = ["crc32-table"],
    deps = ["//genesis-abi:genesis_abi_rs"],
)

rust_test(
    name = "kernel_crypto_test",
    crate = ":kernel_crypto",
)

exports_files(["Cargo.toml"])
