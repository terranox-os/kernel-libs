load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

# ── C allocators (PMM, Pool, Slab) ──────────────────────────

cc_library(
    name = "gen_alloc",
    srcs = [
        "src/bitmap_pmm.c",
        "src/pool.c",
        "src/slab.c",
    ],
    hdrs = ["include/gen_alloc.h"],
    includes = ["include"],
    copts = [
        "-ffreestanding",
        "-nostdlib",
        "-std=c17",
        "-Wall",
        "-Wextra",
        "-Werror",
        "-Wpedantic",
    ],
    deps = [
        "//bitops:gen_bitops",
        "//genesis-abi:genesis_abi",
    ],
)

cc_test(
    name = "alloc_test",
    srcs = ["tests/alloc_test.c"],
    deps = [":gen_alloc"],
    copts = [
        "-std=c17",
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
)

# ── Rust bump allocator ──────────────────────────────────────

rust_library(
    name = "kernel_alloc",
    srcs = [
        "src/lib.rs",
        "src/bump.rs",
    ],
    crate_name = "kernel_alloc",
    edition = "2021",
    deps = ["//genesis-abi:genesis_abi_rs"],
)

rust_test(
    name = "kernel_alloc_test",
    crate = ":kernel_alloc",
)

exports_files(["Cargo.toml"])
